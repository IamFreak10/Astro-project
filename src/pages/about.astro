---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from "../data/site";
const skills = ['HTML', 'CSS', 'JavaScript', 'React', 'Astro', 'Tailwind'];
---

<BaseLayout title="About">
   
    <body>
        <h1>About</h1>
        <h1>Skills</h1>
        {skills.map((skill) => <p>{skill}</p>)}
    </body>

</BaseLayout>

