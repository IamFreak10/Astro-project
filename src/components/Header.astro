---
import { site } from "../data/site";
---


<header>
<nav class="container">
    <a href="/" class="logo">{site.name}</a>
    <div class="links">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
    </div>
</nav>
</header>


<style>
    nav{
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
    }
    .links{
        display: flex;
        gap: 20px;
        align-items: center;
    }
    .logo{
        font-weight: 700;
        font-size: 1.5rem;
    }
</style>